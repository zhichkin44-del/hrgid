# Copy to .env (it is listed in .gitignore). Everything is optional: without values Compose starts
# in no-model mode (answers are refusals); the panel and the law search work.
# Do not commit keys or tokens. Default values are described in the README.

# --- model ---------------------------------------------------------------------------------------
# openrouter | claude | gigachat | yandex | fake (default: fake). Claude and OpenRouter are cross-border
# transfer, see the README. HRGID_LLM_PROVIDER takes precedence over the old name HRGID_PROVIDER.
HRGID_LLM_PROVIDER=
HRGID_PROVIDER=
OPENROUTER_API_KEY=
HRGID_USD_RUB=
ANTHROPIC_API_KEY=
GIGACHAT_CREDENTIALS=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
HRGID_RERANKER=
HRGID_NO_ANSWER_THRESHOLD=

# --- first company ---------------------------------------------------------------------------
HRGID_COMPANY=
HRGID_COMPANY_NAME=
HRGID_ADMIN_EMAIL=
HRGID_ADMIN_NAME=

# --- Telegram -----------------------------------------------------------------------------
# The token is issued by @BotFather; if empty, the bot service waits and writes the reason to the log.
TELEGRAM_BOT_TOKEN=
HRGID_BOT_USERNAME=

# --- security and storage --------------------------------------------------------------------
# Empty secrets are generated at random on the first start and live in the state volume.
HRGID_PANEL_PEPPER=
HRGID_CODE_PEPPER=
# letters and digits only (goes into the connection string); requires Docker Compose v2.24+
POSTGRES_PASSWORD=
# 1 — only over HTTPS
HRGID_SECURE_COOKIE=
# log — sign-in code emails are not saved; empty — a file in the volume (docker compose exec api ls /var/lib/hrgid/outbox)
HRGID_MAIL=
HRGID_RETENTION_DAYS=

# --- web chat and ports ----------------------------------------------------------------------
# Additional invitations: token=company[:group],token2=company2
HRGID_WEB_INVITES=
HRGID_API_PORT=
