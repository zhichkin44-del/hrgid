# Скопируйте в .env (он в .gitignore). Всё необязательно: без значений Compose поднимается
# в режиме без модели (ответы — отказы), панель и поиск по закону работают.
# Ключи и токены не коммитьте. Значения по умолчанию описаны в README.

# --- модель -------------------------------------------------------------------------------
# openrouter | claude | gigachat | yandex | fake (по умолчанию fake). Claude и OpenRouter — трансграничная
# передача, см. README. HRGID_LLM_PROVIDER главнее старого имени HRGID_PROVIDER.
HRGID_LLM_PROVIDER=
HRGID_PROVIDER=
OPENROUTER_API_KEY=
HRGID_USD_RUB=
ANTHROPIC_API_KEY=
GIGACHAT_CREDENTIALS=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
HRGID_RERANKER=
HRGID_NO_ANSWER_THRESHOLD=

# --- первая компания ----------------------------------------------------------------------
HRGID_COMPANY=
HRGID_COMPANY_NAME=
HRGID_ADMIN_EMAIL=
HRGID_ADMIN_NAME=

# --- Telegram -----------------------------------------------------------------------------
# Токен выдаёт @BotFather; пустой — сервис bot ждёт и пишет причину в журнал.
TELEGRAM_BOT_TOKEN=
HRGID_BOT_USERNAME=

# --- безопасность и хранение --------------------------------------------------------------
# Пустые секреты создаются случайными при первом старте и живут в томе state.
HRGID_PANEL_PEPPER=
HRGID_CODE_PEPPER=
# только буквы и цифры (входит в строку подключения); нужен Docker Compose v2.24+
POSTGRES_PASSWORD=
# 1 — только за HTTPS
HRGID_SECURE_COOKIE=
# log — письма с кодом не сохраняются; пусто — файл в томе (docker compose exec api ls /var/lib/hrgid/outbox)
HRGID_MAIL=
HRGID_RETENTION_DAYS=

# --- веб-чат и порты ----------------------------------------------------------------------
# Дополнительные приглашения: токен=компания[:группа],токен2=компания2
HRGID_WEB_INVITES=
HRGID_API_PORT=
